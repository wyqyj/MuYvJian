{
  "name": "muyujian",
  "version": "3.0.8",
  "description": "暮雨笺：本地优先的笔记与考研学习工作台",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyqyj/Dusk-Rain-Note-MuYvJian-.git"
  },
  "bugs": {
    "url": "https://github.com/wyqyj/Dusk-Rain-Note-MuYvJian-/issues"
  },
  "homepage": "https://github.com/wyqyj/Dusk-Rain-Note-MuYvJian-#readme",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "npm run build && npx electron .",
    "pack": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.35.3",
    "@lezer/highlight": "^1.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "codemirror": "^6.0.1",
    "date-fns": "3.6.0",
    "dompurify": "^3.4.13",
    "electron-store": "^8.2.0",
    "highlight.js": "^11.11.1",
    "html-to-docx": "^1.8.0",
    "katex": "^0.16.15",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^18.3.1",
    "react-datepicker": "^7.6.0",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.18",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.lingxi.notes",
    "productName": "MuYuJian",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "electronDist": "electron-dist-local",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pandoc/pandoc.exe",
        "to": "pandoc/pandoc.exe"
      },
      {
        "from": "examples/workbench/",
        "to": "examples/workbench/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills/muyujian-question-book-import/",
        "to": "skills/muyujian-question-book-import/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills/muyujian-plan-import/",
        "to": "skills/muyujian-plan-import/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "UPDATE_NOTICES.md",
        "to": "UPDATE_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MuYuJian"
    }
  }
}
